{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "local": {
      "codegraph": {
        "args": ["serve", "--mcp"],
        "command": "codegraph",
        "env": {},
        "type": "local"
      },
      "unityMCP": {
        "command": ["uvx", "mcp-for-unity"],
        "enabled": true,
        "type": "local"
      }
    }
  },
  "model": "nestra-z-ai/glm-5.2",
  "provider": {
    "nestra-minimax": {
      "models": {
        "MiniMax-M3": {
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 512000, "output": 128000 },
          "name": "MiniMax-M3"
        }
      },
      "name": "minimax (via Nestra)",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.minimaxi.com/anthropic"
      }
    }
  }
}